{
  "name": "@tegg/markdown",
  "private": true,
  "version": "0.1.0-preview.2",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "vite build && tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm test && npm run build && node scripts/check-package.mjs",
    "prepack": "npm run build",
    "prepare": "node scripts/prepare.mjs"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/sdk.d.ts",
  "files": [
    "dist",
    "src",
    "assets",
    "licenses",
    "LICENSE",
    "COMMERCIAL-LICENSE.md",
    "ATTRIBUTION.md",
    "THIRD_PARTY_NOTICES.md",
    "docs",
    "scripts/prepare.mjs",
    "vite.config.ts",
    "tsconfig.json",
    "tsconfig.build.json"
  ],
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-markdown": "^6.3.3",
    "@codemirror/language": "^6.11.3",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.1",
    "@lezer/common": "^1.5.2",
    "@lezer/markdown": "^1.7.2",
    "@viz-js/viz": "^3.18.0",
    "codemirror": "^6.0.2",
    "dompurify": "^3.2.6",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.22",
    "markdown-it": "^14.1.0",
    "markdown-it-deflist": "^4.0.0",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^11.9.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/markdown-it-footnote": "^3.0.3",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "description": "Source-first Markdown reader and editor with required attribution.",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/tegg-studio/tegg-markdown.git"
  },
  "homepage": "https://github.com/tegg-studio/tegg-markdown",
  "exports": {
    ".": {
      "types": "./dist/types/sdk.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./core": {
      "types": "./dist/types/core.d.ts",
      "import": "./dist/core.js"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
